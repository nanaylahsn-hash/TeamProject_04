<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Emanate — HTML5 Landing Page Template</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1b2032;
    --paper:#ffffff;
    --accent:#5c62ec;
    --accent-dark:#4347c9;
    --radius:6px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:var(--paper);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1{font-family:'Jost',sans-serif;}
  a{text-decoration:none;color:inherit;}
  .container{max-width:1140px;margin:0 auto;padding:0 32px;}
  .btn{
    font-family:'Inter',sans-serif;
    cursor:pointer;
    border:none;
    border-radius:var(--radius);
    font-weight:600;
    font-size:0.95rem;
    transition:transform .15s ease, background .15s ease;
    display:inline-block;
  }
  .btn-primary{
    background:var(--accent);
    color:#fff;
    padding:14px 30px;
  }
  .btn-primary:hover{background:var(--accent-dark);transform:translateY(-1px);}
  .btn-ghost{
    background:transparent;
    color:#fff;
    padding:10px 22px;
    border:1px solid rgba(255,255,255,.4);
  }
  .btn-ghost:hover{border-color:#fff;background:rgba(255,255,255,.1);}

  header{
    position:absolute;
    top:0;left:0;right:0;
    z-index:20;
    padding:28px 0;
  }
  nav{display:flex;align-items:center;justify-content:space-between;}
  .brand{
    display:flex;align-items:center;gap:10px;
    font-family:'Jost',sans-serif;
    font-size:1.25rem;font-weight:600;letter-spacing:.5px;color:#fff;
  }
  .brand .dot{
    width:14px;height:14px;border-radius:50%;
    background:radial-gradient(circle at 30% 30%, #9aa0ff, var(--accent) 70%);
    box-shadow:0 0 0 4px rgba(255,255,255,.18);
  }
  .nav-links{display:flex;align-items:center;gap:36px;}
  .nav-links a{
    color:rgba(255,255,255,.85);
    font-size:.95rem;font-weight:500;
    transition:color .15s;
  }
  .nav-links a:hover{color:#fff;}
  .nav-cta{display:flex;align-items:center;gap:14px;}

  .hero{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    overflow:hidden;
    background:
      linear-gradient(180deg, rgba(18,20,43,.55) 0%, rgba(18,20,43,.4) 100%),
      url('https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=1600&q=80')
      center/cover no-repeat;
  }
  .hero-inner{position:relative;z-index:2;max-width:760px;padding:0 24px;}
  .hero h1{
    color:#fff;
    font-size:clamp(2.4rem, 5.5vw, 4rem);
    font-weight:700;
    line-height:1.08;
    letter-spacing:-.5px;
    margin-bottom:22px;
    text-shadow:0 2px 24px rgba(0,0,0,.25);
  }
  .hero p{
    color:rgba(255,255,255,.92);
    font-size:1.15rem;
    max-width:560px;
    margin:0 auto 36px;
    text-shadow:0 1px 12px rgba(0,0,0,.2);
  }

  @media (max-width:900px){
    .nav-links{display:none;}
  }
</style>
</head>
<body>

<header>
  <div class="container">
    <nav>
      <a href="#" class="brand"><span class="dot"></span>EMANATE</a>
      <div class="nav-links">
        <a href="#">Home</a>
        <a href="#">Style Guide</a>
        <a href="#">Pricing</a>
      </div>
      <div class="nav-cta">
        <a href="#" class="btn-ghost btn">Log In</a>
        <a href="#" class="btn-primary btn">Sign Up</a>
      </div>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="hero-inner">
    <h1>Emanate HTML Template</h1>
    <p>A minimal and responsive HTML5 landing page built on lightweight, clean and customizable code.</p>
    <a href="#" class="btn-primary btn">Get started, it's free!</a>
  </div>
</section>

</body>
</html>
