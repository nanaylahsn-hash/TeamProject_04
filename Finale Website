<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Emanate — HTML5 Landing Page Template</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1b2032;
    --paper:#ffffff;
    --accent:#5c62ec;
    --accent-dark:#4347c9;
    --radius:6px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:var(--paper);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1{font-family:'Jost',sans-serif;}
  a{text-decoration:none;color:inherit;}
  .container{max-width:1140px;margin:0 auto;padding:0 32px;}
  .btn{
    font-family:'Inter',sans-serif;
    cursor:pointer;
    border:none;
    border-radius:var(--radius);
    font-weight:600;
    font-size:0.95rem;
    transition:transform .15s ease, background .15s ease;
    display:inline-block;
  }
  .btn-primary{
    background:var(--accent);
    color:#fff;
    padding:14px 30px;
  }
  .btn-primary:hover{background:var(--accent-dark);transform:translateY(-1px);}
  .btn-ghost{
    background:transparent;
    color:#fff;
    padding:10px 22px;
    border:1px solid rgba(255,255,255,.4);
  }
  .btn-ghost:hover{border-color:#fff;background:rgba(255,255,255,.1);}
  header{
    position:absolute;
    top:0;left:0;right:0;
    z-index:20;
    padding:28px 0;
  }
  nav{display:flex;align-items:center;justify-content:space-between;}
  .brand{
    display:flex;align-items:center;gap:10px;
    font-family:'Jost',sans-serif;
    font-size:1.25rem;font-weight:600;letter-spacing:.5px;color:#fff;
  }
  .brand .dot{
    width:14px;height:14px;border-radius:50%;
    background:radial-gradient(circle at 30% 30%, #9aa0ff, var(--accent) 70%);
    box-shadow:0 0 0 4px rgba(255,255,255,.18);
  }
  .nav-links{display:flex;align-items:center;gap:36px;}
  .nav-links a{
    color:rgba(255,255,255,.85);
    font-size:.95rem;font-weight:500;
    transition:color .15s;
  }
  .nav-links a:hover{color:#fff;}
  .nav-cta{display:flex;align-items:center;gap:14px;}
  .hero{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    overflow:hidden;
    background:
      linear-gradient(180deg, rgba(18,20,43,.55) 0%, rgba(18,20,43,.4) 100%),
      url('https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=1600&q=80')
      center/cover no-repeat;
  }
  .hero-inner{position:relative;z-index:2;max-width:760px;padding:0 24px;}
  .hero h1{
    color:#fff;
    font-size:clamp(2.4rem, 5.5vw, 4rem);
    font-weight:700;
    line-height:1.08;
    letter-spacing:-.5px;
    margin-bottom:22px;
    text-shadow:0 2px 24px rgba(0,0,0,.25);
  }
  .hero p{
    color:rgba(255,255,255,.92);
    font-size:1.15rem;
    max-width:560px;
    margin:0 auto 36px;
    text-shadow:0 1px 12px rgba(0,0,0,.2);
  }
  @media (max-width:900px){
    .nav-links{display:none;}
  }
</style>
<style>
  :root {
    --text-dark: #1f2430;
    --text-muted: #4a5164;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-dark);
    background: #fff;
    padding: 40px 20px;
  }

  .features {
    max-width: 1200px;
    margin: 0 auto;
    border: 1px solid #e4e6ec;
    border-radius: 4px;
    padding: 64px 48px;
  }

  .features-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 56px;
  }

  .features-header h2 {
    font-size: 28px;
    font-weight: 700;
    color: #161a24;
  }

  .features-header p {
    margin-top: 16px;
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    row-gap: 48px;
    justify-items: center;
  }

  .feature-item {
    text-align: center;
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
  }

  .feature-icon svg { width: 26px; height: 26px; }

  .feature-item span {
    font-size: 14px;
    font-weight: 700;
    color: #1f2430;
  }

  .icon-pink { background: #ec6ea3; }
  .icon-cyan { background: #29c1e8; }
  .icon-mint { background: #55d6b0; }
  .icon-indigo { background: #4c5fd5; }
  .icon-sage { background: #8fcf9f; }
  .icon-tan { background: #d9a982; }
  .icon-blue { background: #3d7ce0; }
  .icon-purple { background: #8b3fd4; }

  @media (max-width: 768px) {
    .features { padding: 40px 20px; }
    .features-grid { grid-template-columns: repeat(2, 1fr); row-gap: 36px; }
  }
</style>
<style>
  :root{
    --bg-dark: #1a1a2e;
    --bg-white: #ffffff;
    --card-bg: #23233d;
    --card-border: #34345a;
    --text-white: #ffffff;
    --text-muted: #9d9db3;
    --text-body: #b6b6c8;
    --btn-bg: #3d3d5c;
    --btn-bg-hover: #4a4a70;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg-white);
  }

  .spacer {
    height: 60px;
    background: var(--bg-white);
  }

  .pricing-section {
    background: var(--bg-dark);
    padding: 70px 24px 90px;
    text-align: center;
  }

  .pricing-section h1 {
    color: var(--text-white);
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 12px;
  }

  .pricing-section .subtitle {
    color: var(--text-muted);
    font-size: 16px;
    margin: 0 0 36px;
  }

  .toggle-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 48px;
  }

  .toggle-label {
    color: var(--text-white);
    font-size: 13px;
    font-weight: 700;
  }

  .switch {
    position: relative;
    width: 44px;
    height: 24px;
    background: #4a4a6a;
    border-radius: 999px;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: background 0.2s ease;
  }

  .switch.on {
    background: #6c6ce0;
  }

  .switch .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s ease;
  }

  .switch.on .knob {
    transform: translateX(20px);
  }

  .cards {
    display: flex;
    justify-content: center;
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
    flex-wrap: wrap;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 28px 28px 32px;
    width: 280px;
    text-align: left;
  }

  .card .plan-name {
    color: var(--text-white);
    font-size: 12px;
    font-weight: 700;
    margin: 0 0 14px;
  }

  .card .price {
    color: var(--text-white);
    font-size: 34px;
    font-weight: 700;
    margin: 0 0 20px;
  }

  .card .price .per {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .card .desc {
    color: var(--text-body);
    font-size: 15px;
    line-height: 1.5;
    margin: 0 0 24px;
    min-height: 70px;
  }

  .card button.purchase {
    width: 100%;
    background: var(--btn-bg);
    color: var(--text-white);
    border: none;
    border-radius: 4px;
    padding: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .card button.purchase:hover {
    background: var(--btn-bg-hover);
  }

  .footer-bar {
    height: 70px;
    background: var(--bg-white);
  }

  .footer-dark {
    height: 40px;
    background: #17172a;
  }

  @media (max-width: 700px) {
    .cards { flex-direction: column; align-items: center; }
    .card { width: 100%; max-width: 320px; }
  }
</style>
