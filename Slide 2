<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Based On Modular Design</title>
<style>
  :root {
    --text-dark: #1f2430;
    --text-muted: #4a5164;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-dark);
    background: #fff;
    padding: 40px 20px;
  }

  .features {
    max-width: 1200px;
    margin: 0 auto;
    border: 1px solid #e4e6ec;
    border-radius: 4px;
    padding: 64px 48px;
  }

  .features-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 56px;
  }

  .features-header h2 {
    font-size: 28px;
    font-weight: 700;
    color: #161a24;
  }

  .features-header p {
    margin-top: 16px;
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    row-gap: 48px;
    justify-items: center;
  }

  .feature-item {
    text-align: center;
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
  }

  .feature-icon svg { width: 26px; height: 26px; }

  .feature-item span {
    font-size: 14px;
    font-weight: 700;
    color: #1f2430;
  }

  .icon-pink { background: #ec6ea3; }
  .icon-cyan { background: #29c1e8; }
  .icon-mint { background: #55d6b0; }
  .icon-indigo { background: #4c5fd5; }
  .icon-sage { background: #8fcf9f; }
  .icon-tan { background: #d9a982; }
  .icon-blue { background: #3d7ce0; }
  .icon-purple { background: #8b3fd4; }

  @media (max-width: 768px) {
    .features { padding: 40px 20px; }
    .features-grid { grid-template-columns: repeat(2, 1fr); row-gap: 36px; }
  }
</style>
</head>
<body>

  <section class="features">
    <div class="features-header">
      <h2>Based On Modular Design</h2>
      <p>Build awesome websites or landing pages with simple and independent parts.</p>
    </div>

    <div class="features-grid">
      <div class="feature-item">
        <div class="feature-icon icon-pink">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V4h4"/><path d="M20 8V4h-4"/><path d="M4 16v4h4"/><path d="M20 16v4h-4"/><rect x="8" y="8" width="8" height="8" rx="1"/></svg>
        </div>
        <span>Minimal Design</span>
      </div>

      <div class="feature-item">
        <div class="feature-icon icon-cyan">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12.5a15 15 0 0 1 20 0"/><path d="M5 16a10 10 0 0 1 14 0"/><path d="M8.5 19.5a5 5 0 0 1 7 0"/><circle cx="12" cy="20.5" r="1" fill="white" stroke="none"/></svg>
        </div>
        <span>Rocket Fast</span>
      </div>

      <div class="feature-item">
        <div class="feature-icon icon-mint">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="7" y1="14" x2="11" y2="14"/><line x1="7" y1="17" x2="15" y2="17"/></svg>
        </div>
        <span>Custom Framework</span>
      </div>

      <div class="feature-item">
        <div class="feature-icon icon-indigo">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5c2-1 5-1 7 0v14c-2-1-5-1-7 0z"/><path d="M20 5c-2-1-5-1-7 0v14c2-1 5-1 7 0z"/></svg>
        </div>
        <span>Style Guide</span>
      </div>

      <div class="feature-item">
        <div class="feature-icon icon-sage">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 8 5 12 9 16"/><polyline points="15 8 19 12 15 16"/></svg>
        </div>
        <span>CSS + SASS</span>
      </div>

      <div class="feature-item">
        <div class="feature-icon icon-tan">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
        </div>
        <span>100% Customizable</span>
      </div>

      <div class="feature-item">
        <div class="feature-icon icon-blue">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="3" x2="12" y2="21"/><line x1="3" y1="12" x2="12" y2="12"/></svg>
        </div>
        <span>Modular Design</span>
      </div>

      <div class="feature-item">
        <div class="feature-icon icon-purple">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <span>HTML5 Valid</span>
      </div>
    </div>
  </section>

</body>
</html>
